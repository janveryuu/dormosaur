{
  "name": "dormosaur",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node scripts/test-copilot.mjs && node --test tests/hardening.test.mjs && node scripts/test-schedule-scanner.mjs && tsx --test tests/scanner.test.ts && node scripts/test-template-registry.mjs",
    "test:copilot:live": "node scripts/test-copilot.mjs --live",
    "typecheck": "tsc --noEmit",
    "android:build": "cd mobile && npx eas-cli@latest build -p android --profile preview",
    "mobile": "cd mobile && npx expo start",
    "video:studio": "remotion preview remotion/index.ts",
    "video:render": "remotion render remotion/index.ts DormosaurAppleLaunch out/dormosaur-launch.mp4",
    "video:render-vertical": "remotion render remotion/index.ts DormosaurAppleShort out/dormosaur-short.mp4",
    "video:render-demo": "remotion render remotion/index.ts DormosaurDemo out/dormosaur-demo.mp4",
    "eval:scanner": "tsx --env-file=.env.local scripts/eval-scanner.ts",
    "audio": "node --env-file=.env.local scripts/elevenlabs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "groq-sdk": "^1.5.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.3.289",
    "react": "^19",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "ua-parser-js": "^2.0.10",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "@remotion/bundler": "4.0.546",
    "@remotion/cli": "4.0.546",
    "@remotion/google-fonts": "4.0.546",
    "@remotion/media-utils": "4.0.546",
    "@remotion/player": "4.0.546",
    "@remotion/renderer": "4.0.546",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jspdf": "^4.2.1",
    "postcss": "^8.5",
    "remotion": "4.0.546",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  }
}
