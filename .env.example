# ─── Dormosaur Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local for local development.
# Set these variables in Vercel Project Settings -> Environment Variables for Production.

# ── 1. Supabase Backend / Database ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── 2. Web Push Notifications (VAPID Keys) ──
# Generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@dormosaur.app

# ── 3. Vercel Cron Authorization Secret ──
# Secret header checked by /api/notifications/cron to block unauthorized calls
CRON_SECRET=your-random-cron-secret-token

# ── 4. App URL ──
NEXT_PUBLIC_APP_URL=https://your-dormosaur-domain.vercel.app

# ── 5. AI / LLM Keys (Optional for Syllabus Parsing & AI Recipes) ──
OPENAI_API_KEY=your-openai-api-key
