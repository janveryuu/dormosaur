# ─── Dormosaur Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local for local development.
# Set these variables in Vercel Project Settings -> Environment Variables for Production.

# ── 1. Supabase Backend / Database ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── 2. Web Push Notifications (VAPID Keys) ──
# Generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@dormosaur.app

# ── 3. Vercel Cron Authorization Secret ──
# Secret header checked by /api/notifications/cron to block unauthorized calls
CRON_SECRET=your-random-cron-secret-token

# ── 4. App URL ──
NEXT_PUBLIC_APP_URL=https://your-dormosaur-domain.vercel.app

# ── 5. AI / LLM Keys (Server-only) ──
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Copilot: Groq primary -> secondary Groq model -> Gemini if its key is present.
# With only a Gemini key, Gemini becomes primary. Set keys in Vercel Production
# as well as .env.local; redeploy after changing environment variables.
DORMOSAUR_COPILOT_PROVIDER=groq
DORMOSAUR_COPILOT_MODEL=openai/gpt-oss-120b
DORMOSAUR_COPILOT_GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Provider-specific overrides used when that provider is secondary.
DORMOSAUR_COPILOT_GROQ_MODEL=openai/gpt-oss-120b
DORMOSAUR_COPILOT_GEMINI_MODEL=gemini-2.5-flash
# Gemini chat configuration is independent of the schedule parser in lib/gemini.ts.
